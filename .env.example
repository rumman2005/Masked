PORT=3001
VITE_SOCKET_URL=http://localhost:3001

# Server-side AI providers (leave empty for deterministic local/offline AI).
# The chain is tried from left to right; unknown names are ignored.
AI_PROVIDER_CHAIN=
# Example switchable chain:
# AI_PROVIDER_CHAIN=gemini,cohere,groq,nvidia-nim
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONCURRENCY=4
AI_BACKOFF_BASE_MS=250
AI_COOLDOWN_MS=10000
AI_MAX_BACKOFF_MS=30000

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=
